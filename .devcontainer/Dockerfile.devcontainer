FROM ros:kilted

ENV DEBIAN_FRONTEND=noninteractive

ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=devuser

# Reassign default 'ubuntu' user to avoid UID/GID conflicts
RUN if id -u ubuntu &>/dev/null; then \
  usermod -u 2000 -d /home/ubuntu ubuntu && \
  groupmod -g 2000 ubuntu; \
  fi

# Create user matching host UID/GID
RUN groupadd -g ${USER_GID} ${USERNAME} && \
  useradd -u ${USER_UID} -g ${USER_GID} -m -s /bin/bash ${USERNAME}

# Install base development dependencies
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  build-essential \
  ca-certificates \
  clang \
  clang-tools \
  clangd \
  clang-format \
  clang-tidy \
  cmake \
  git \
  gnupg \
  libusb-1.0-0-dev \
  ninja-build \
  openssh-client \
  && rm -rf /var/lib/apt/lists/*

# Install development analysis and debugging tools
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  cppcheck \
  doxygen \
  gawk \
  gdb \
  graphviz \
  lcov \
  valgrind \
  && rm -rf /var/lib/apt/lists/*

# Install additional CLI and system tools
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  bash-completion \
  curl \
  fontconfig \
  iputils-ping \
  libdbus-1-dev \
  locales \
  lsb-release \
  net-tools \
  software-properties-common \
  sudo \
  tar \
  tree \
  usbutils \
  vim \
  xterm \
  wget \
  && rm -rf /var/lib/apt/lists/*

# Install ROS and workspace dependencies
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  python3-colcon-common-extensions \
  python3-rosdep \
  python3-vcstool \
  ros-kilted-camera-info-manager \
  ros-kilted-camera-info-manager-py \
  ros-kilted-controller-manager \
  ros-kilted-depth-image-proc \
  ros-kilted-diff-drive-controller \
  ros-kilted-gz-ros2-control \
  ros-kilted-image-proc \
  ros-kilted-joint-state-broadcaster \
  ros-kilted-joint-state-publisher \
  ros-kilted-joint-state-publisher-gui \
  ros-kilted-joy \
  ros-kilted-joy-linux \
  ros-kilted-nav2-bringup \
  ros-kilted-nav2-rviz-plugins \
  ros-kilted-openni2-camera \
  ros-kilted-pointcloud-to-laserscan \
  ros-kilted-robot-localization \
  ros-kilted-robot-state-publisher \
  ros-kilted-ros-gz \
  ros-kilted-rviz-default-plugins \
  ros-kilted-rviz-imu-plugin \
  ros-kilted-rviz2 \
  ros-kilted-slam-toolbox \
  ros-kilted-teleop-twist-joy \
  ros-kilted-teleop-twist-keyboard \
  ros-kilted-xacro \
  && rm -rf /var/lib/apt/lists/*

# Install Kvaser CANLIB SDK userspace package for ROS2 kvaser_interface.
# RUN add-apt-repository -y ppa:astuff/kvaser-linux && \
#   apt-get update && \
#   apt-get install -y --no-install-recommends kvaser-canlib-dev && \
#   rm -rf /var/lib/apt/lists/*

# Install YDLidar SDK from source so FindPackage(ydlidar_sdk) works in the workspace.
RUN git clone --depth 1 https://github.com/YDLIDAR/YDLidar-SDK.git /tmp/YDLidar-SDK && \
  cmake -S /tmp/YDLidar-SDK -B /tmp/YDLidar-SDK/build -DCMAKE_BUILD_TYPE=Release && \
  cmake --build /tmp/YDLidar-SDK/build -j"$(nproc)" && \
  cmake --install /tmp/YDLidar-SDK/build && \
  rm -rf /tmp/YDLidar-SDK

# Gazebo Ionic repository and simulator packages
RUN sudo curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
  --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
  | sudo tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null && \
  apt-get update && apt-get install -y --no-install-recommends \
  gz-ionic && \
  rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US.UTF-8 && \
  update-locale LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8

RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
  chmod 0440 /etc/sudoers.d/${USERNAME}

RUN mkdir -p /workspaces/src && chown -R ${USERNAME}:${USERNAME} /workspaces

USER ${USERNAME}
WORKDIR /workspaces

RUN git config --global --add safe.directory /workspaces && \
  echo "source /opt/ros/kilted/setup.bash" >> ~/.bashrc && \
  echo "if [ -f /etc/bash_completion ]; then source /etc/bash_completion; fi" >> ~/.bashrc
