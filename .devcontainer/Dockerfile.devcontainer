FROM ros:kilted

ENV DEBIAN_FRONTEND=noninteractive
ARG USER_UID=1000
ARG USER_GID=1000

SHELL ["/bin/bash", "-c"]

RUN apt update && apt install -y \
  git \
  openssh-client \
  iputils-ping \
  net-tools \
  curl \
  nano \
  python3-vcstool \
  python3-rosdep \
  python3-colcon-common-extensions \
  build-essential \
  clang \
  clang-tidy \
  clang-format \
  sudo \
  && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true
RUN rosdep update --rosdistro kilted

RUN if getent group ${USER_GID} > /dev/null 2>&1; then \
      groupmod --new-name dev $(getent group ${USER_GID} | cut -d: -f1); \
    else \
      groupadd --gid ${USER_GID} dev; \
    fi && \
    if getent passwd ${USER_UID} > /dev/null 2>&1; then \
      usermod -l dev -d /home/dev -m -s /bin/bash $(getent passwd ${USER_UID} | cut -d: -f1); \
    else \
      useradd --uid ${USER_UID} --gid ${USER_GID} -ms /bin/bash dev; \
    fi && \
    echo "dev ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER dev
WORKDIR /workspaces

RUN echo "source /opt/ros/kilted/setup.bash" >> ~/.bashrc
